{
  "manifest_version": 3,
  "name": "AtendeFlow",
  "short_name": "AtendeFlow",
  "description": "Atalho pra abrir o painel do AtendeFlow numa aba — clica no ícone pra abrir ou focar a aba já aberta.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Abrir AtendeFlow"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["tabs"],
  "host_permissions": ["https://atendeflow.confiancatechnologies.com/*"]
}
