{
  "name": "atendeflow",
  "private": true,
  "version": "2.0.0",
  "description": "AtendeFlow - CRM de multi atendimento com integração WhatsApp (base zappro-legado)",
  "scripts": {
    "install:backend": "npm install --prefix backend",
    "install:frontend": "npm install --prefix frontend --legacy-peer-deps",
    "install:api-oficial": "npm install --prefix api_oficial",
    "install:all": "npm run install:backend && npm run install:frontend && npm run install:api-oficial",
    "dev:backend": "npm run dev:server --prefix backend",
    "dev:frontend": "npm start --prefix frontend",
    "dev:api-oficial": "npm run start:dev --prefix api_oficial",
    "db:migrate": "npm run db:migrate --prefix backend",
    "db:seed": "npm run db:seed --prefix backend",
    "build:backend": "npm run build --prefix backend",
    "build:frontend": "npm run build --prefix frontend"
  }
}
