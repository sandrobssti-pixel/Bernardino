# Porta onde o painel do NAS fica disponível.
PORT=8092

# Chave usada pra assinar o cookie de sessão do login — gere um valor
# aleatório único por servidor (nunca reaproveite entre servidores
# diferentes), ex.: `openssl rand -hex 32`.
SESSION_SECRET=

# Usuário/senha do ADMIN INICIAL — só usado na primeira vez que o painel
# sobe, se ainda não existir nenhum usuário cadastrado (ver data/users.json).
# Depois do primeiro login, gerencie usuários pela própria tela "Usuários"
# do painel.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# Pastas que o navegador de arquivos pode acessar — SEMPRE uma lista
# explícita, nunca a raiz do disco. Formato: "Rótulo:/caminho,Rótulo2:/caminho2".
# Use os mesmos pontos de montagem já configurados pro backup no NAS (ver
# docs/MANUAL_TECNICO.md, seção 38).
NAS_ROOTS="Backups:/mnt/nas-backup,Seafile:/mnt/nas-seafile"

# Tamanho máximo de upload, em MB (padrão: 2048 = 2GB).
#NAS_MAX_UPLOAD_MB=2048

# --- Integração com a API do Synology DSM (discos/desligamento) ---
# Opcional: sem isso preenchido, o painel funciona normalmente só como
# navegador de arquivos — a aba de discos/desligamento fica desabilitada.
# Use uma conta ADMINISTRADORA do DSM dedicada a isso, nunca a mesma conta
# de serviço do SMB (atendeflow-sync não tem esse propósito).
#DSM_HOST=192.168.3.21
#DSM_PORT=5001
#DSM_HTTPS=true
#DSM_USER=
#DSM_PASSWORD=
