# Copia dependências locais ("file:...", como o toolkit-auth) pra dentro
# de node_modules em vez de criar link simbólico — sem isso, o require()
# de dentro do pacote local (ex.: cookie-session, chamado de dentro do
# toolkit-auth) resolve pelo caminho real do symlink e não acha as
# dependências instaladas aqui em node_modules. Também deixa o `pkg`
# (empacotador do executável) mais previsível, sem symlink pra seguir.
install-links=true
