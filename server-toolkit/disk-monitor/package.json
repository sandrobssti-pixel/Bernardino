{
  "name": "disk-monitor",
  "version": "1.1.0",
  "private": true,
  "description": "Monitor de disco e limpeza automática — módulo do server-toolkit, reaproveitável em qualquer servidor novo de cliente",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --targets node18-linux-x64 --output ../dist/disk-monitor-linux"
  },
  "dependencies": {
    "express": "^4.22.2",
    "node-cron": "^3.0.3",
    "dotenv": "^16.0.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [],
    "targets": [
      "node18-linux-x64"
    ]
  }
}
