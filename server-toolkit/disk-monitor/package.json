{
  "name": "disk-monitor",
  "version": "1.4.0",
  "private": true,
  "description": "Monitor de disco e limpeza automática — módulo do server-toolkit, reaproveitável em qualquer servidor novo de cliente",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run build:linux && npm run build:win",
    "build:linux": "pkg . --targets node18-linux-x64 --output ../dist/linux/disk-monitor-linux",
    "build:win": "pkg . --targets node18-win-x64 --output ../dist/windows/disk-monitor.exe"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "check-disk-space": "^3.4.0",
    "cookie-session": "^2.1.0",
    "dotenv": "^16.0.0",
    "express": "^4.22.2",
    "node-cron": "^3.0.3",
    "systeminformation": "^5.33.13",
    "toolkit-auth": "file:../shared/auth"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [],
    "targets": [
      "node18-linux-x64",
      "node18-win-x64"
    ]
  }
}
