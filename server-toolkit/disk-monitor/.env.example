# Porta onde o painel do vps-monitor fica disponível.
PORT=8091

# Usuário e senha do painel (autenticação básica HTTP) — o painel roda
# limpeza de disco, então NUNCA deve ficar exposto na internet sem senha
# nem sem VPN/túnel SSH. Troque esses valores antes de rodar.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-esta-senha

# Caminho verificado pelo monitor de disco (raiz do servidor por padrão).
MOUNT_PATH=/
