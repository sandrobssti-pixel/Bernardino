# Porta onde o painel do disk-monitor fica disponível.
PORT=8091

# Chave usada pra assinar o cookie de sessão do login — gere um valor
# aleatório único por servidor (nunca reaproveite entre servidores
# diferentes), ex.: `openssl rand -hex 32`. Trocar esse valor derruba
# todo mundo que estiver logado (força um novo login), mas não apaga
# nenhum usuário.
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Usuário/senha do ADMIN INICIAL — só usado na primeira vez que o painel
# sobe, se ainda não existir nenhum usuário cadastrado (ver data/users.json).
# Depois do primeiro login, gerencie usuários pela própria tela "Usuários"
# do painel (só quem é admin vê essa tela) — pode até apagar essas duas
# linhas depois, elas não são mais usadas uma vez que já existe usuário.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-esta-senha

# Caminho/unidade verificado pelo monitor de disco. Sem essa linha, usa
# a raiz de cada sistema sozinho: "/" no Linux, "C:\" no Windows. Só
# precisa preencher se quiser monitorar outro disco/pasta específico:
#   Linux:   MOUNT_PATH=/
#   Windows: MOUNT_PATH=C:\
#MOUNT_PATH=/

# --- Painel do NAS (opcional) ---
# Sem NAS_ROOTS preenchido, essa seção do painel simplesmente não
# aparece — o resto do disk-monitor funciona normal. Preencha só nos
# servidores que têm um NAS de verdade. Formato:
# "Rótulo:/caminho,Rótulo2:/caminho2" — use os mesmos pontos de montagem
# já configurados pro backup (docs/MANUAL_TECNICO.md, seção 38).
#NAS_ROOTS="Backups:/mnt/nas-backup,Seafile:/mnt/nas-seafile"
# Tamanho máximo de upload, em MB (padrão: 2048 = 2GB).
#NAS_MAX_UPLOAD_MB=2048

# --- Integração com a API do Synology DSM (discos/desligamento) ---
# Também opcional, e independente do NAS_ROOTS acima. Use uma conta
# ADMINISTRADORA do DSM dedicada a isso — nunca a mesma conta de
# serviço usada pro compartilhamento SMB.
#DSM_HOST=192.168.3.21
#DSM_PORT=5001
#DSM_HTTPS=true
#DSM_USER=
#DSM_PASSWORD=
#DSM_ALLOW_SELF_SIGNED=true
# Se essa conta tiver verificação em duas etapas ativada (recomendado —
# nunca desligue o 2FA só pra essa integração funcionar): faça UMA VEZ
# um login manual incluindo o código de 6 dígitos e "enable_device_token=yes"
# (ver README, seção do painel do NAS, "Login com verificação em duas
# etapas"), pegue o "device_id" que a resposta devolve, e cole aqui —
# esse servidor passa a ser reconhecido como dispositivo confiável, sem
# precisar mais do código nas próximas vezes.
#DSM_DEVICE_ID=
