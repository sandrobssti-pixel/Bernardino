# Porta onde o painel do disk-monitor fica disponível.
PORT=8091

# Chave usada pra assinar o cookie de sessão do login — gere um valor
# aleatório único por servidor (nunca reaproveite entre servidores
# diferentes), ex.: `openssl rand -hex 32`. Trocar esse valor derruba
# todo mundo que estiver logado (força um novo login), mas não apaga
# nenhum usuário.
SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Usuário/senha do ADMIN INICIAL — só usado na primeira vez que o painel
# sobe, se ainda não existir nenhum usuário cadastrado (ver data/users.json).
# Depois do primeiro login, gerencie usuários pela própria tela "Usuários"
# do painel (só quem é admin vê essa tela) — pode até apagar essas duas
# linhas depois, elas não são mais usadas uma vez que já existe usuário.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=troque-esta-senha

# Caminho verificado pelo monitor de disco (raiz do servidor por padrão).
MOUNT_PATH=/
