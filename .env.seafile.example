# Copie para .env.seafile na VPS (não commitar o arquivo real no git)
# e preencha com valores fortes/reais antes de subir o Seafile.

# Senha root do MariaDB dedicado ao Seafile (gere com: openssl rand -base64 24)
SEAFILE_DB_ROOT_PASSWORD=

# Login do administrador do Seafile
SEAFILE_ADMIN_EMAIL=
SEAFILE_ADMIN_PASSWORD=

# Domínio público de acesso (precisa ter uma rota criada no túnel Cloudflare
# apontando pra http://confianza-seafile:80 — ver docs/MANUAL_TECNICO.md)
SEAFILE_SERVER_HOSTNAME=arquivos.confiancatechnologies.com
