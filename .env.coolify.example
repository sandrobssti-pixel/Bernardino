# Variáveis pra colar na aba de "Environment Variables" do recurso
# "Docker Compose" no Coolify (o que usa docker-compose.coolify.yml).
# Nunca commitar este arquivo preenchido com valores reais.
#
# Ver docs/MANUAL_TECNICO.md, seção "Deploy com Coolify", pra onde achar
# cada valor (domínio, credenciais do Postgres do Coolify etc.).

# --- URLs públicas (domínios que você vai apontar no Coolify) ---
BACKEND_URL=https://api.seudominio.com.br
FRONTEND_URL=https://app.seudominio.com.br

# --- Postgres (o recurso que já está configurado no Coolify) ---
DB_HOST=nome-interno-do-servico-postgres-no-coolify
DB_PORT=5432
DB_NAME=atendeflow
DB_USER=atendeflow
DB_PASS=troque-esta-senha

# --- Segurança (gere valores aleatórios únicos, nunca reaproveite) ---
JWT_SECRET=
JWT_REFRESH_SECRET=
MASTER_KEY=
REDIS_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# --- Frontend (variáveis de BUILD — exigem rebuild se mudar depois) ---
REACT_APP_BACKEND_URL=https://api.seudominio.com.br
REACT_APP_NUMBER_SUPPORT=
REACT_APP_WA_CONNECT_URL=

# --- Cloudflare Tunnel (deixa tudo acessível pela internet sem IP público) ---
# Token do túnel, gerado ao criar o túnel em Cloudflare Zero Trust >
# Networks > Tunnels > Create a tunnel > Cloudflared. Configure lá os
# "Public Hostnames" apontando pra http://backend:8080 e
# http://frontend:3000 (nomes dos serviços deste compose).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Opcionais (deixe em branco se não usar) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM="AtendeFlow <no-reply@seudominio.com>"
USE_WHATSAPP_OFICIAL=false
URL_API_OFICIAL=
TOKEN_API_OFICIAL=
COMPANY_TOKEN=
ENV_TOKEN=
VERIFY_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
