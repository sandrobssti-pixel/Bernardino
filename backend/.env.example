# AtendeFlow (base zappro-legado) — variáveis de ambiente do backend
# Compilado a partir do uso real de process.env no código-fonte.
# Nenhum valor real de produção deve ir neste arquivo — apenas exemplos/placeholders.

# --- Servidor ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
BACKEND_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000
PROXY_PORT=8080

# --- Banco de dados (PostgreSQL via Sequelize) ---
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=atendeflow
DB_USER=atendeflow
DB_PASS=atendeflow
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# --- Redis (filas Bull, cache, ack de mensagens) ---
REDIS_URI=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URI_ACK=
REDIS_SECRET_KEY=troque-esta-chave
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000
IO_REDIS_URI=redis://localhost:6379
IO_REDIS_PORT=6379

# --- Autenticação ---
JWT_SECRET=gere-um-segredo-aleatorio-aqui
JWT_REFRESH_SECRET=gere-outro-segredo-aleatorio-aqui
MASTER_KEY=gere-uma-chave-mestra-aqui
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
# Deixe COOKIE_DOMAIN em branco/comentado na maioria dos casos — o cookie
# de refresh token fica automaticamente restrito ao próprio host do
# backend, que é o único que precisa lê-lo. Só preencha se o
# frontend/backend rodarem em SUBDOMÍNIOS DIFERENTES do MESMO domínio e
# você quiser compartilhar o cookie entre eles (nesse caso, use o domínio
# pai com ponto na frente, ex.: ".seudominio.com.br" — nunca "localhost"
# em produção: um valor de Domain incompatível com o host real faz o
# navegador REJEITAR o cookie inteiro, o que quebra a renovação de sessão
# e desloga o usuário sem aviso).
# COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- E-mail (SendMail) ---
MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASS=
MAIL_SECURE=false
MAIL_FROM="AtendeFlow <no-reply@seudominio.com>"

# --- Painel de filas (Bull Board) ---
BULL_BOARD=false
BULL_USER=admin
BULL_PASS=troque-esta-senha

# --- Integração com a API Oficial do WhatsApp (submódulo api_oficial/) ---
USE_WHATSAPP_OFICIAL=false
URL_API_OFICIAL=http://localhost:6000
TOKEN_API_OFICIAL=
COMPANY_TOKEN=
ENV_TOKEN=
VERIFY_TOKEN=

# --- Meta (Facebook/Instagram) ---
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- Pagamentos/cobrança (SaaS) — preencha apenas o gateway usado ---
PAYMENT_GATEWAY=
MP_ACCESS_TOKEN=
ASAAS_API_KEY=
ASAAS_BASE_URL=https://api.asaas.com/v3
ASAAS_WEBHOOK_SECRET=
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
EFI_CERTIFICATE=
EFI_CERTIFICATE_PASSPHRASE=
EFI_PIX_KEY=
EFI_SANDBOX=true
GERENCIANET_CLIENT_ID=
GERENCIANET_CLIENT_SECRET=
GERENCIANET_PIX_CERT=
GERENCIANET_SANDBOX=true
PUSHINPAY_TOKEN=
PUSHINPAY_BASE_URL=https://api.pushinpay.com.br

# --- Diversos ---
DEMO=false
APP_TRIALEXPIRATION=7
SENTRY_DSN=
SOCKET_ADMIN=false
FFMPEG_PATH=
IMPORT_FALLBACK_FILE=
FLOW_MENU_COOLDOWN_SEC=30
FLOW_REENGAGEMENT_ENABLED=false
AI_AUTO_MAX_RESPONSE_MESSAGES=3
TOKEN_ADMIN=
